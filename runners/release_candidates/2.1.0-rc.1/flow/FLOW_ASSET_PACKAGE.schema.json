{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MATA History Today Flow Asset Package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scene_id", "flow_asset_mode", "source_image_path", "source_image_preview",
    "source_image_sha256", "scene_duration", "visual_purpose", "character_or_subject",
    "camera_motion", "subject_motion", "environment_motion", "continuity_requirements",
    "negative_prompt", "aspect_ratio", "resolution", "fps", "output_filename",
    "flow_prompt_zh_tw", "flow_prompt_en", "manual_steps", "resume_watch_folder"
  ],
  "properties": {
    "scene_id": {"type": "string", "minLength": 1},
    "flow_asset_mode": {"enum": ["APPROVED_REGRESSION_ASSET", "PRODUCTION_MANUAL_FLOW"]},
    "source_image_path": {"type": "string", "minLength": 1},
    "source_image_preview": {"type": "string", "minLength": 1},
    "source_image_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "scene_duration": {"type": "number", "exclusiveMinimum": 0},
    "visual_purpose": {"type": "string", "minLength": 20},
    "character_or_subject": {"type": "string", "minLength": 5},
    "camera_motion": {"type": "string", "minLength": 10},
    "subject_motion": {"type": "string", "minLength": 10},
    "environment_motion": {"type": "string", "minLength": 10},
    "continuity_requirements": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 4}},
    "negative_prompt": {"type": "array", "minItems": 12, "items": {"type": "string", "minLength": 2}},
    "aspect_ratio": {"const": "9:16"},
    "resolution": {"const": "1080x1920"},
    "fps": {"const": 30},
    "output_filename": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+\\.mp4$"},
    "flow_prompt_zh_tw": {"type": "string", "minLength": 300},
    "flow_prompt_en": {"type": "string", "minLength": 300},
    "manual_steps": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "string", "minLength": 30}},
    "resume_watch_folder": {"type": "string", "minLength": 1}
  }
}
