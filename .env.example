# Copy to .env or define in Windows user environment. Never commit real values.
MATA_STUDIO_DATA_DIR=C:\Users\YOUR_NAME\AppData\Local\MATA-AI-VIDEO-STUDIO
MATA_STUDIO_PORT=8765
# Path to a LOCAL OAuth client configuration. The application never stores it in Git.
MATA_DRIVE_CLIENT_CONFIG=C:\Users\YOUR_NAME\.mata\google-drive-oauth-client.json
